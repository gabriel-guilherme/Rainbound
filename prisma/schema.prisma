generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  BOOK
  COMIC
  MANGA
}

enum FileFormat {
  EPUB
  PDF
  CBZ
  CBR
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  READ
  ABANDONED
}

model Book {
  id Int @id @default(autoincrement())

  title       String
  creator     String?
  description String?

  type   ContentType
  format FileFormat

  rating Int?
  notes  String?

  filePath String?

  coverUrl      String?
  coverPublicId String?

  status     ReadingStatus @default(WANT_TO_READ)
  startedAt  DateTime?
  finishedAt DateTime?

  progress ReadingProgress?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([format])
  @@index([status])
}

model ReadingProgress {
  id Int @id @default(autoincrement())

  bookId Int @unique
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  currentPosition Int @default(0)
  totalPositions  Int?

  percentage Float @default(0)

  locator String?

  updatedAt DateTime @updatedAt
}
